# Copy to .env and fill in. Never commit .env.

# ---- Server / data stores -------------------------------------------------
PORT=4000
# Despite the legacy name, this is the full MongoDB connection URI
MONGO_PORT=mongodb://localhost:27017/fundoo
REDIS_HOST=localhost
REDIS_PORT=6379
# Used only by the standalone scripts in ElasticSearch/ (e.g. http://localhost:9200)
ELASTIC_PORT=http://localhost:9200

# Base URL put into emailed links (defaults to http://localhost:$PORT)
APP_URL=http://localhost:4000

# ---- Auth -----------------------------------------------------------------
# Long random string used to sign JWTs, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SECRET_KEY=

# ---- Mail (Gmail via nodemailer): use a Gmail *app password*, not your login password
EMAIL=
PASSWORD=

# ---- AWS S3 (profile picture upload; the picUpload mutation is not wired up yet)
AWS_ID=
AWS_SECRET=

# ---- GitHub OAuth app (https://github.com/settings/developers) ------------------
CLIENT_ID=
CLIENT_SECRET=
# OAuth endpoints
GIT_CODE=https://github.com/login/oauth/authorize
GIT_ACCESS=https://github.com/login/oauth/access_token
# Callback URL registered in the GitHub OAuth app
GIT_LINK=http://localhost:4000

# ---- GitHub API endpoints (all of these are plain GitHub URLs) -----------------
GET_RESPONSE=https://api.github.com/user
GIT_REPOSITORY=https://api.github.com/user/repos
GIT_FETCH_REPO=https://api.github.com/graphql
APOLLO_REPO_FETCH=https://api.github.com/graphql
# Prefix URLs: the code appends  <owner>/<repo>/...  (note the trailing slash)
GIT_COLAB=https://api.github.com/repos/
GIT_COMMITS=https://api.github.com/repos/
GET_CREATE_BRANCH=https://api.github.com/repos/
POST_CREATE_BRANCH=https://api.github.com/repos/
ADD_WATCH_IN_GIT=https://api.github.com/repos/
DELETE_WATCH_IN_GIT_REPO=https://api.github.com/repos/
DELETE_BRANCH=https://api.github.com/repos/
DELETE_REPO=https://api.github.com/repos/
CREATE_REPO=https://api.github.com/user/repos
# ---- GitHub: values specific to your account ------------------------------------
# GraphQL node id of the repository that starRepository / removeStarRepository act on
GIT_ID=
