{
  "name": "fundoo",
  "version": "1.0.0",
  "description": "Fundoo Notes backend: a notes app API (users, notes, labels, collaborators) built on Apollo GraphQL, with GitHub OAuth/API integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "nodemon": "nodemon server.js",
    "test": "NODE_ENV=test nyc --reporter=lcov --reporter=text mocha testing/test.js --exit",
    "coverage": "NODE_ENV=test nyc -r cobertura -r text-summary -r html mocha testing/test.js --exit",
    "showcoverage": "open coverage/lcov-report/index.html"
  },
  "author": "Bhupendra Singh",
  "license": "ISC",
  "engines": {
    "node": ">=14"
  },
  "dependencies": {
    "apollo-fetch": "^0.7.0",
    "apollo-server": "^2.25.4",
    "async-redis": "^1.1.7",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "dotenv": "^8.6.0",
    "elasticsearch": "^16.7.3",
    "graphql": "^14.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^5.13.22",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^2.10.0",
    "nodemailer": "^6.9.16",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.9",
    "nyc": "^15.1.0",
    "supertest": "^6.3.4"
  }
}
